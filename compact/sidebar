${voffset 2}${alignr 38}${color}${fs_used /run/media/ernesto/MAXTOR} / ${fs_size /run/media/ernesto/MAXTOR}
${else}\
${image ~/conky/monochrome/images/compact/burgundy-no-disk.png -p 35,920}\
${voffset 13}${offset 40}${color1}sdd device
${voffset 3}${offset 40}${color1}${font4}is not connected
