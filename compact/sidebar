${voffset -2}${offset 38}${color1}up    ${color}${upspeed enp0s25}${alignr 38}${color}${downspeed enp0s25}  ${color1}down
${voffset 3}${offset 38}${color1}total ${color}${totalup enp0s25}${alignr 38}${color}${totaldown enp0s25} ${color1}total
${else}\
${image ~/conky/monochrome/images/compact/burgundy-no-network.png -p 35,452}\
${voffset 12}${offset 40}${color1}no network
${voffset 3}${offset 40}connection
${voffset 73}
${endif}\
