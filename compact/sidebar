${voffset 69}${offset 38}${color1}free${goto 74}${color}${memfree}${alignr 38}${color}${swap}${color1} swap    
${voffset 3}${offset 38}${color1}buff${goto 74}${color}${buffers}${alignr 38}${color}${cat /tmp/conky/system.swap.read}${color1} swap in 
${voffset 3}${offset 38}${color1}cache${goto 74}${color}${cached}${alignr 38}${cat /tmp/conky/system.swap.write}${color1} swap out
${image ~/conky/monochrome/images/compact/burgundy-table-fields.png -p 35,332}\
${voffset 6}${offset 38}${color1}process${alignr 38}memory   perc${voffset 5}
${voffset 3}${color}${offset 38}${top_mem name 1}${alignr 38}${top_mem mem_res 1}${top_mem mem 1}%
${voffset 3}${color}${offset 38}${top_mem name 2}${alignr 38}${top_mem mem_res 2}${top_mem mem 2}%
