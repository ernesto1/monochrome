${voffset 2}${offset 38}${color}home${alignr 40}${voffset 1}${color3}${if_match ${fs_used_perc /home} > 90}${color2}${endif}${fs_bar 3,100 /home}
${voffset 2}${alignr 38}${color}${fs_used /home} / ${fs_size /home}
# :::: sdb
${if_existing /dev/sdb}\
${image ~/conky/monochrome/images/compact/burgundy-disk.png -p 37,720}\
${image ~/conky/monochrome/images/compact/burgundy-graph-io.png -p 77,720}\
${voffset 7}${offset 77}${color}${diskiograph_read /dev/sdb 35,74 665d1e bdb76b 250000}${offset 3}${diskiograph_write /dev/sdb 35,74 5c111f c01e20 250000}
${voffset -2}${offset 38}${color1}read  ${color}${diskio_read /dev/sdb}${alignr 38}${color}${diskio_write /dev/sdb} ${color1}write
