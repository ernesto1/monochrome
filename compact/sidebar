${voffset 2}${offset 38}${color}betty${alignr 40}${voffset 1}${color3}${if_match ${fs_used_perc /media/betty} > 90}${color2}${endif}${fs_bar 3,100 /media/betty}
${voffset 2}${alignr 38}${color}${fs_used /media/betty} / ${fs_size /media/betty}
${else}\
