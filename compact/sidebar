${voffset 15}${goto 80}${color1}local ip ${color}${addr enp0s25}
${voffset 3}${goto 80}${color1}speed    ${color}${execi 180 ethtool enp0s25 2>/dev/null | grep -i speed | cut -d ' ' -f 2}
# :: upload/download speeds
${image ~/conky/monochrome/images/compact/burgundy-internet.png -p 37,504}\
${image ~/conky/monochrome/images/compact/burgundy-graph-io.png -p 77,504}\
